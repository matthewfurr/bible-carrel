<header class="site-header">
  <a class="brand" href="{{ '/' | url }}">
    <img src="{{ '/img/icon-64.png' | url }}" width="64" height="64" alt="">
    <span>{{ site.name }}</span>
  </a>
  {#- The current section carries aria-current: the guide's link for every guide page. Build it comes first, so it never wraps alone. #}
  {%- set here = page.url or "" %}
  <nav class="site-nav" aria-label="Site">
    <a href="{{ '/build/' | url }}"{% if here == "/build/" %} aria-current="page"{% endif %}>Build it</a>
    <a href="{{ '/#reader' | url }}">Features</a>
    <a href="{{ '/guide/first-chapter/' | url }}"{% if here.startsWith("/guide/") %} aria-current="page"{% endif %}>Guide</a>
    <a href="{{ '/sources/' | url }}"{% if here == "/sources/" %} aria-current="page"{% endif %}>Sources</a>
    <a href="{{ '/roadmap/' | url }}"{% if here == "/roadmap/" %} aria-current="page"{% endif %}>Roadmap</a>
    <a href="{{ '/contribute/' | url }}"{% if here == "/contribute/" %} aria-current="page"{% endif %}>Contribute</a>
    {%- if site.repoUrl %}
    <a href="{{ site.repoUrl }}">GitHub</a>
    {%- endif %}
  </nav>
  <button type="button" class="appearance" hidden aria-label="Switch to dark appearance" title="Switch to dark appearance">
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/></svg>
  </button>
</header>
